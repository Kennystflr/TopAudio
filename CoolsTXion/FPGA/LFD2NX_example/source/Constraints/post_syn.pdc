## These constraints are targetted to Certus-NX Versa Evalaution board
create_clock -name {virt_clk} -period 10
set_clock_uncertainty -setup 0.5 [get_clocks CLK]
ldc_set_location -site {G3} [get_ports fifo_write_en]
ldc_set_location -site {J16} [get_ports RESET_N]
ldc_set_location -site {L10} [get_ports {request[0]}]
ldc_set_location -site {E16} [get_ports {request[1]}]
ldc_set_location -site {L11} [get_ports {request[2]}]
ldc_set_location -site {R3} [get_ports {request[3]}]
ldc_set_location -site {G13} [get_ports clock_in]
ldc_set_location -site {B3} [get_ports {grant[0]}]
ldc_set_location -site {A2} [get_ports {grant[1]}]
ldc_set_location -site {H16} [get_ports {grant[2]}]
ldc_set_location -site {B2} [get_ports {grant[3]}]
ldc_set_location -site {G16} [get_ports {seg_out[0]}]
ldc_set_location -site {G14} [get_ports {seg_out[1]}]
ldc_set_location -site {G12} [get_ports {seg_out[2]}]
ldc_set_location -site {G11} [get_ports {seg_out[3]}]
ldc_set_location -site {E12} [get_ports {seg_out[4]}]
ldc_set_location -site {E10} [get_ports {seg_out[5]}]
ldc_set_location -site {E9} [get_ports {seg_out[6]}]
ldc_set_location -site {F9} [get_ports {seg_out[7]}]
set_input_delay -clock [get_clocks virt_clk] 1 [get_ports {request[3] request[1] request[0] RESET_N fifo_write_en request[2]}]
set_output_delay -clock [get_clocks virt_clk] 1 [get_ports {seg_out[0] seg_out[1] grant[1] seg_out[5] seg_out[6] seg_out[4] grant[3] seg_out[3] grant[0] grant[2] seg_out[7] seg_out[2]}]
set_false_path -from [get_clocks virt_clk]
set_false_path -to [get_clocks virt_clk]
